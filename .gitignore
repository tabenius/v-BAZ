# Local staging / build artifacts
vbaz-stage/
*.apkovl.tar.gz
*.log

# Downloaded release blobs (fetched by the installer at runtime)
windows/**/vmlinuz-*
windows/**/initramfs-*
windows/**/modloop-*
refind*.zip
refind_x64.efi

# Secure Boot: never commit shim binaries or MOK key material
windows/secureboot/*.efi
mok/
*.pfx
*.pfx.pass
vbaz-mok.*

# Smoke-test artifacts (downloaded blobs, built images, logs)
test/cache/
test/*.img
test/last-serial.log

# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store
*.swp
