# rEFInd configuration generated by v-BAZ (Install-VBaz.ps1).
# Placeholders (@@...@@) are substituted at install time.
#
# Boot chain:  Windows Boot Manager  ->  refind_x64.efi  ->  this file
#
# Two stanzas are defined:
#   1. "@@ENTRYNAME@@"           - first-boot INSTALL/PROVISION (default now)
#   2. "@@ENTRYNAME@@ (installed)"- boots the installed system on VBAZ_ROOT
#
# On a successful first boot, the provisioner rewrites this file so the
# "(installed)" stanza becomes the default. Until then, the diskless
# installer stanza runs.

timeout 10
use_nvram false
scanfor manual
# The ext4 driver lets rEFInd read /boot on the installed ext4 root.
scan_driver_dirs EFI/@@ESPSUBDIR@@/drivers_x64
# RAGBAZ / v-BAZ boot splash (staged next to this file on the ESP).
banner EFI/@@ESPSUBDIR@@/splash.png
banner_scale fillscreen

# --- Stanza 1: diskless Alpine that runs the v-BAZ provisioner ---------
# NOTE ON BOOT PARAMETERS (Alpine mkinitfs / initramfs):
#   modloop=<url>    fetch the kernel module squashfs over the network
#   alpine_repo=<url> package repo used by the in-RAM installer
#   ip=dhcp          bring up networking in the initramfs
#   The apkovl (vbaz.apkovl.tar.gz) is auto-discovered from the ESP root by
#   the initramfs overlay scan; it carries the provisioner + config.
# If your Alpine release needs different params, edit the options line and
# re-select this entry. Refs: https://wiki.alpinelinux.org/wiki/Boot_options
menuentry "@@ENTRYNAME@@" {
    icon     /EFI/@@ESPSUBDIR@@/refind_x64.efi
    loader   /EFI/@@ESPSUBDIR@@/vmlinuz-lts
    initrd   /EFI/@@ESPSUBDIR@@/initramfs-lts
    options  "modules=loop,squashfs,sd-mod,usb-storage,ext4 quiet console=tty0 ip=dhcp modloop=@@MODLOOP_URL@@ alpine_repo=@@ALPINE_REPO@@ vbaz_provision=1"
}

# --- Stanza 2: the installed system (populated after provisioning) -----
# The provisioner copies the installed kernel/initramfs to the ESP and
# enables this entry as the default. Kept here disabled until then.
menuentry "@@ENTRYNAME@@ (installed)" {
    disabled
    loader   /EFI/@@ESPSUBDIR@@/vmlinuz-lts-installed
    initrd   /EFI/@@ESPSUBDIR@@/initramfs-lts-installed
    options  "root=LABEL=@@ROOTLABEL@@ modules=sd-mod,usb-storage,ext4 rw quiet"
}
