# v-BAZ smoke-test overlay environment (a ready-made vbaz.env).
#
# build-apkovl.sh copies this verbatim to etc/vbaz/vbaz.env inside the apkovl,
# so the QEMU test drives the exact same provisioner code path as a real
# install. Keys mirror what windows/lib/Apkovl.ps1 writes.
#
# Defaults are a LIGHT set for a fast smoke run. Flip PACKAGE_SETS to the full
# list (and KATA_DEVMAPPER=1) to exercise the whole stack - slower, more RAM.

VBAZ_ROOTLABEL='VBAZ_ROOT'
VBAZ_ROOTTYPE='0fc63daf-8483-4772-8e79-3d69d8477de4'
VBAZ_SWAPLABEL='VBAZ_SWAP'
VBAZ_HOSTNAME='vbaz-test'
VBAZ_USERNAME='operator'
VBAZ_TIMEZONE='UTC'
VBAZ_BRANCH='v3.21'
VBAZ_MIRROR='https://dl-cdn.alpinelinux.org/alpine'
VBAZ_ARCH='x86_64'
VBAZ_FLAVOR='lts'
VBAZ_ESPSUBDIR='vbaz'
VBAZ_PACKAGE_SETS='base virt zfs'
VBAZ_ZFS_ENABLE='1'
VBAZ_ZFS_TYPE='6a898cc3-1dd2-11b2-99a6-080020736631'
VBAZ_ZFS_POOL='vbaz'
VBAZ_ZFS_LABEL='VBAZ_ZFS'
VBAZ_ZFS_DATASETS='vms docker firecracker kata images iso'
VBAZ_SECUREBOOT='0'
VBAZ_MOK_CN='CN=v-BAZ Machine Owner Key'
VBAZ_KATA_DEVMAPPER='0'
VBAZ_THINPOOL_NAME='vbaz-thinpool'
VBAZ_THINPOOL_DATASIZE='8G'
VBAZ_THINPOOL_METASIZE='256M'
VBAZ_KATA_BASE_IMAGE_SIZE='2GB'
VBAZ_VERBOSE='1'
VBAZ_WIFI_SSID=''
VBAZ_WIFI_COUNTRY=''
VBAZ_WIFI_FIRMWARE='linux-firmware'
VBAZ_OFFLINE='0'
